{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@gyo/shared": ["./packages/shared/src/index.ts"],
      "@gyo/server": ["./packages/server/src/app.ts"],
      "@gyo/server/*": ["./packages/server/src/*"]
    }
  },
  "include": ["packages/shared/src/**/*"],
  "references": [
    { "path": "./packages/server" },
    { "path": "./packages/cli" },
    { "path": "./packages/shared" }
  ]
}
